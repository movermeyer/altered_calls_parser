{
  "name": "altered-calls-parser",
  "version": "0.1.0",
  "description": "Unofficial, fan-made parser to parse, validate, normalize, and autocomplete Altered LARP calls. Not affiliated with or endorsed by the creators of Altered LARP.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "esbuild ../demo/src/main.ts --bundle --outfile=../demo/dist/bundle.js --format=iife --platform=browser --target=es2022 --loader:.g4=text --minify --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p ../demo/tsconfig.json"
  },
  "dependencies": {
    "antlr4ng": "3.0.16",
    "antlr4-c3": "3.4.4"
  },
  "devDependencies": {
    "antlr-ng": "1.0.10",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "@types/node": "26.2.0"
  }
}
